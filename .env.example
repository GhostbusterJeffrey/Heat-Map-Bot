ELITE_ROLE_NAME=Tier 2 Elite Member
OWNER_USER_ID=

DEFAULT_PRESET=swing
DEFAULT_EXPIRIES=12
DEFAULT_STRIKES=61
MAX_EXPIRIES=24
MAX_STRIKES=101
COOLDOWN_SECONDS=15
MAX_CONCURRENT_ANALYSES=2
ANALYSIS_WORKERS=2
RENDER_WORKERS=1
MAX_UPLOAD_MB=9.5

INTRADAY_EXPIRIES=5
INTRADAY_STRIKES=41
INTRADAY_WINDOW_PCT=0.05
SWING_EXPIRIES=12
SWING_STRIKES=61
SWING_WINDOW_PCT=0.10
MACRO_EXPIRIES=20
MACRO_STRIKES=81
MACRO_WINDOW_PCT=0.18

MIN_CONTRACTS_TO_RENDER=50
MIN_USABLE_RATIO=0.05
MIN_CONFIDENCE_TO_RENDER=35
MAX_WALL_DISTANCE_PCT=0.12
MIN_WALL_QUALITY=0.40
MIN_WALL_PERCENTILE=0.70
MIN_EXPIRY_SHARE_FOR_BREADTH=0.025
MIN_FLIP_CONFIDENCE=0.45
FLIP_GRID_LOW_PCT=0.85
FLIP_GRID_HIGH_PCT=1.15
FLIP_GRID_POINTS=601
PIN_DECAY_DAYS=7.0
