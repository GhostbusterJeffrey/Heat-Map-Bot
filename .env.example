VOLUME_LIQUIDITY_WEIGHT=0.50

RESULT_CACHE_TTL_SECONDS=75
RATE_CACHE_TTL_SECONDS=21600
PROVIDER_CACHE_TTL_SECONDS=30
USE_TREASURY_CURVE=true
STATIC_RISK_FREE_RATE=0.045
CONTRACT_MULTIPLIER=100
DEFAULT_LIQUIDITY_MODE=auto
DEFAULT_EXPOSURE_MODE=net_proxy

# Quant engine rollout: legacy preserves Alpha 4.0 output, shadow records the
# candidate comparison while displaying legacy, and candidate opts into 4.1.
QUANT_ENGINE_MODE=legacy

ASSETS_DIR=assets
MAIN_LOGO_PATH=assets/main.jpg
DEVELOPER_LOGO_PATH=assets/developer.jpg
TRADER_LOGO_PATH=assets/trader.jpg
SIBEI_LOGO_PATH=assets/sibei.jpg
LOG_LEVEL=INFO

# Alpha 4 historical public-options snapshots
SNAPSHOT_ENABLED=true
SNAPSHOT_DB_PATH=data/tpr_options_history.sqlite3
SNAPSHOT_RETENTION_DAYS=730

# /netimpact: configure private credentials on the server, not in this package.
TRADIER_ACCESS_TOKEN=
# Optional alternative: a private file path accessible INSIDE the server/container.
TRADIER_ENV_FILE=
NETIMPACT_DB_PATH=data/netimpact.sqlite3
NETIMPACT_TICKERS=SPY,QQQ,IWM,TSLA,NVDA,AMD,AAPL,MSFT,META,AMZN,GOOGL,AVGO,ORCL,PLTR,MU,NFLX,COIN,MSTR,INTC,CRM
